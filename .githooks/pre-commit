#!/usr/bin/env bash
# Block commits that contain secrets. gitleaks if installed (scripts/01-toolchain.sh), else a pattern scan.
set -euo pipefail
if command -v gitleaks >/dev/null; then
  exec gitleaks protect --staged --redact --no-banner
fi
echo "pre-commit: gitleaks not installed (H-TOOLCHAIN); running fallback pattern scan" >&2
if git diff --cached -U0 | grep -E '^\+' | grep -Eq 'ed25519:[1-9A-HJ-NP-Za-km-z]{60,}|secp256k1:[1-9A-HJ-NP-Za-km-z]{60,}|BEGIN [A-Z ]*PRIVATE KEY|"private_key"\s*:|\[([0-9]{1,3},){63}[0-9]{1,3}\]'; then
  echo "pre-commit: possible private key in staged changes — commit blocked" >&2; exit 1
fi
