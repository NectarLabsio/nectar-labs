{
  "name": "@nectar/ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Nectar Network design system components (docs/DESIGN_SYSTEM.md). Colors live only in tokens.css.",
  "exports": {
    ".": { "types": "./src/index.ts", "default": "./src/index.ts" },
    "./tokens.css": "./tokens.css",
    "./fonts.css": "./fonts.css",
    "./components.css": "./components.css",
    "./logo/*": "./logo/*"
  },
  "sideEffects": ["*.css"],
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "node scripts/check-no-literal-colors.mjs"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.2.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "~5.9.3"
  }
}
