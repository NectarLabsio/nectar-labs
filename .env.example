# Nectar Labs — every variable, no values. Copy to .env (root) and apps/web/.env.local / services/*/.env.local.
# Keys are PATHS to 0600 files under ~/.nectar/, never key material.

NEAR_NETWORK=testnet
NEAR_RPC_URL=https://test.rpc.fastnear.com

# filled by scripts/00-accounts.sh + 20-deploy-testnet.sh (mirrored in packages/config/config.yaml)
OWNER_ACCOUNT_ID=TODO-G2
CORE_ACCOUNT_ID=TODO-G2
USDC_MOCK_ID=TODO-G2
NVDAX_MOCK_ID=TODO-G2
KEEPER_ACCOUNT_ID=TODO-G2
KEEPER_KEY_PATH=~/.nectar/keys/keeper.function-call.json      # function-call key only
DEMO_BORROWER_ID=TODO-G2
DEMO_BORROWER_KEY_PATH=~/.nectar/keys/borrower1.json           # E2E write flow only

# P1
OUTLAYER_ACCOUNT_ID=outlayer.testnet
OUTLAYER_PROJECT_ID=TODO-G4
OUTLAYER_VERSION_KEY=TODO-G4
QUOTER_WASM_SHA256=TODO-G4
ORACLE_SOURCE=owner                 # owner (live, disclosed) | pyth-oracle.testnet (built; needs H13 key, D-013). price-oracle.testnet does not serve NVDA (C-012)
NVDA_PRICE_ID=b1073854ed24cbc755dc527418f52b7d271f6cc967bbf8d8129112b18860a593   # F-053 Equity.US.NVDA/USD
HERMES_URL=https://hermes-beta.pyth.network
ONE_CLICK_BASE_URL=https://1click.chaindefuser.com
ONE_CLICK_API_KEY=                  # HUMAN H8 (optional)

# P2
SOLANA_CLUSTER=devnet
SOLANA_RPC_URL=https://api.devnet.solana.com
KEEPER_SOLANA_KEYPAIR=~/.nectar/solana/keeper-fee-payer.json
NECTAR_VAULT_PROGRAM_ID=             # default solana.vault_program in config.yaml
NECTAR_VAULT_AUTHORITY=TODO-G7      # MPC-derived Ed25519 pubkey
SIGNER_ACCOUNT_ID=v1.signer-prod.testnet
SIGNER_PATH=solana-v1
NEAR_AI_BASE_URL=https://cloud-api.near.ai/v1
NEAR_AI_API_KEY=                    # HUMAN H7
NEAR_AI_MODEL=

# P2b Base spoke (keeper relay; empty BASE_RPC_URL = relay off). Chain 84532 only. Foundry keystore, never a raw key.
BASE_RPC_URL=                       # http://127.0.0.1:8545 (local fork) or https://sepolia.base.org
BASE_KEYSTORE_DIR=~/.foundry/keystores
BASE_ACCOUNT=nectar-keeper          # keystore file name (cast wallet new <dir> <name>)
BASE_PASSWORD_FILE=~/.nectar/base/keeper.password   # 0600
BASE_VAULT_ADDRESS=                 # optional cross-check of the pinned 0x vault
BASE_KEEPER_ATTEST=0                # 1 = local fork: keeper_attest_deposit instead of confirm_remote_deposit

# web / docs
NEXT_PUBLIC_FEED_URL=http://localhost:8787
NEXT_PUBLIC_ANALYTICS=off           # off | ga4 | plausible  (HUMAN H4)
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=

# never set by an agent
# HUMAN_CONFIRMED=1

# x402 paid feed export (WO-25; near:testnet only). Ids and PATHS only; both keys are full-access (F-328).
X402_FACILITATOR_URL=               # empty = in-process facilitator with the relayer below
X402_RELAYER_ACCOUNT_ID=            # default v7.x402_relayer in config.yaml (x402-relayer.nectar.testnet)
X402_RELAYER_KEY_PATH=              # e.g. ~/.nectar/keys/x402-relayer.json (0600)
AGENT1_ACCOUNT_ID=                  # default v7.agent1 (agent1.nectar.testnet)
AGENT1_KEY_PATH=                    # e.g. ~/.nectar/keys/agent1.json (0600)
X402_FACILITATOR_PORT=               # set to expose the facilitator over HTTP (needs the secret path below)
X402_FACILITATOR_HOST=               # default 127.0.0.1
X402_FACILITATOR_SECRET_PATH=        # 0600 file with the bearer token, e.g. ~/.nectar/keys/x402-facilitator.secret
