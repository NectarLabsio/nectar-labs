{
  "name": "nectar-labs",
  "private": true,
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=22.22.2"
  },
  "scripts": {
    "prepare": "git config core.hooksPath .githooks 2>/dev/null || true",
    "lint": "pnpm -r --if-present lint",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "verify:quick": "node scripts/check-no-branding-all.mjs && pnpm lint && pnpm typecheck && pnpm test",
    "verify": "pnpm verify:quick && bash scripts/50-verify.sh",
    "demo:testnet": "bash scripts/50-verify.sh",
    "demo:capture": "pnpm --filter web demo:capture"
  },
  "devDependencies": {
    "yaml": "2.9.1"
  }
}
