{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev -p 3100",
    "build": "node scripts/build-changelog.mjs && next build",
    "changelog": "node scripts/build-changelog.mjs",
    "start": "next start -p 3100",
    "typecheck": "next typegen && tsc --noEmit -p tsconfig.json",
    "lint": "node ../../packages/ui/scripts/check-no-literal-colors.mjs && node scripts/check-no-branding.mjs",
    "test": "node --test --test-reporter=spec --import ./scripts/node-test-shims.mjs lib/api/api.test.ts lib/api/health.test.ts lib/copilot/verify.test.ts",
    "e2e": "playwright test",
    "e2e:screens": "playwright test e2e/screens.spec.ts",
    "demo:capture": "playwright test e2e/screens.spec.ts",
    "lighthouse": "node scripts/lighthouse.mjs",
    "test:copilot": "node scripts/test-copilot.mjs",
    "copilot:fixture": "node scripts/build-copilot-fixture.ts"
  },
  "dependencies": {
    "@hot-labs/near-connect": "0.12.0",
    "@nectar/sdk": "workspace:*",
    "@nectar/ui": "workspace:*",
    "@noble/curves": "2.2.0",
    "@noble/hashes": "2.2.0",
    "@phala/dcap-qvl": "0.7.1",
    "@solana/kit": "8.6.0",
    "@solana/wallet-standard-features": "1.5.0",
    "@wallet-standard/core": "1.1.2",
    "marked": "^18.1.3",
    "near-api-js": "7.4.0",
    "next": "16.4.5",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "0.160.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "0.160.0",
    "chrome-launcher": "1.2.3",
    "lighthouse": "13.6.0",
    "typescript": "~5.9.3",
    "yaml": "^2.9.1"
  },
  "engines": {
    "node": ">=22.22.2"
  }
}
