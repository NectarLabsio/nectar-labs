# apps/web hosted env (WO-34a, WO-62b). Leave everything unset for local single-host mode (G9 default: every route on one host, no redirects).
# Server-side values are read by next.config.ts / proxy.ts / route handlers. Only non-secret URLs reach the browser (NEXT_PUBLIC_*).
# Never put a key or secret in a NEXT_PUBLIC_* variable. An RPC key, if one is ever needed, stays behind a server route.
# Production values: packages/config/config.yaml site.production_hosts (set in the Vercel project env).

# Landing host (/, /about, /legal/*, /security, /changelog, /brand, /talk; /status too while STATUS_URL is unset). Example: https://nectarlabs.io
SITE_URL=
# App host (every other route; APP / redirects to /feed). Example: https://testnet.nectarlabs.io
APP_URL=
# Docs host (Docusaurus, pages at its root). SITE/APP /docs and /docs/<rest> 308 to DOCS_URL/<rest>; docs links point here without /docs/.
# Empty: the in-app /docs page. Example: https://docs.nectarlabs.io
DOCS_URL=
# Status host. Its / serves the status page; any other path 308s to its canonical host; SITE/APP /status 308 to it. Empty: /status on SITE.
# Example: https://status.nectarlabs.io
STATUS_URL=
# Old hostnames that 308 to a canonical origin, same path + query: comma list host=site|app|docs|status. Server-side.
# Example: old-site.example.dev=site,old-app.example.dev=app (the real *.vercel.app list lives in the Vercel env only).
LEGACY_HOSTS=
# Feed API origin (services/feed), reached only through /api/indexer. Server-side. Local default: unset ("indexer not connected").
# NEXT_PUBLIC_FEED_URL is still read as a fallback for older local setups; it is not sent to the browser.
FEED_URL=
# Public repository URL. Empty: every repository link is hidden.
REPO_URL=

# Production guard: VERCEL_ENV=production (set by Vercel) or NECTAR_PRODUCTION=1 makes the build fail while SITE_URL / APP_URL are
# unset or config.yaml site.operator / site.country / site.contact is null (TODO-H-LEGAL). Non-production sends X-Robots-Tag: noindex.
# NECTAR_PRODUCTION=

# Public, non-secret client settings (unchanged):
# NEXT_PUBLIC_NEAR_RPC=https://test.rpc.fastnear.com
# NEXT_PUBLIC_SOLANA_RPC=https://api.devnet.solana.com
# NEXT_PUBLIC_EXPLORER_TX=
# NEXT_PUBLIC_EXPLORER_ACCOUNT=
# NEXT_PUBLIC_FAUCET_URL=
# NEXT_PUBLIC_NVDAX_FAUCET_URL=
