{
  "name": "@nectar/solana",
  "private": true,
  "type": "module",
  "description": "nectar_vault (Anchor 0.32.1) local-validator tests and the Ed25519 verify-instruction client helper (solana/client)",
  "engines": {
    "node": ">=22.22.2"
  },
  "scripts": {
    "wallet:local": "mkdir -p .localnet && (test -f .localnet/wallet.json || solana-keygen new --no-bip39-passphrase --silent -o .localnet/wallet.json)",
    "build": "anchor build",
    "test:unit": "cargo test -p nectar_vault --lib",
    "test:anchor": "pnpm run wallet:local && anchor test",
    "test:ts": "node --disable-warning=ExperimentalWarning --test --test-concurrency=1 \"tests/**/*.test.ts\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@coral-xyz/anchor": "0.32.1",
    "@solana/spl-token": "0.4.15",
    "@solana/web3.js": "1.99.0"
  },
  "devDependencies": {
    "@solana/kit": "8.6.0",
    "@types/bn.js": "5.2.0",
    "@types/node": "22.20.5",
    "typescript": "5.9.3"
  }
}
