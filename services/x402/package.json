{
  "name": "x402",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "x402 paid route for the Feed CSV export on near:testnet (0.01 mock USDC), own facilitator, demo agent. Testnet only.",
  "engines": {
    "node": ">=22.22.2"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning src/main.ts",
    "demo:testnet": "node --disable-warning=ExperimentalWarning src/demo-agent.ts",
    "test": "node --disable-warning=ExperimentalWarning --test \"test/**/*.test.ts\"",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@fastnear/x402": "2.5.0",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@x402/core": "2.18.0",
    "@x402/near": "2.18.0",
    "near-api-js": "7.4.0"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "typescript": "5.6.3"
  }
}
