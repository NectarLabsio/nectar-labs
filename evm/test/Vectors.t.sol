pragma solidity 0.8.30;

import {VaultFixture} from "./VaultFixture.sol";
import {NectarVaultBase} from "../src/NectarVaultBase.sol";

/// @notice Writes test/eip712_vectors.json: fixed-input EIP-712 Settle/Release digests for nectar-core (WO-29a)
///         to match byte for byte, each with a vm.sign signature from the fixture's throwaway test scalar
///         (AUTH_PK in VaultFixture.sol; never a real key). Re-run: `forge test --match-contract Vectors`.
///         Output is deterministic; a diff in the committed file means the encoding changed.
contract Vectors is VaultFixture {
    /// "NectarVaultBase" ‖ 0x0000000001 — a fixed verifyingContract so the vectors do not depend on nonces.
    address internal constant VECTOR_VAULT = address(bytes20(hex"4e65637461725661756c74426173650000000001"));
    string internal constant PATH = "./test/eip712_vectors.json";

    function setUp() public override {
        super.setUp();
        deployCodeTo("NectarVaultBase.sol:NectarVaultBase", abi.encode(address(token), address(registry)), VECTOR_VAULT);
        vault = NectarVaultBase(VECTOR_VAULT);
    }

    function test_writeVectors() public {
        assertEq(address(vault), VECTOR_VAULT);
        address recipient = address(bytes20(hex"bcb6eab973570cb1e5c16195696b8bddb4c7d8f7"));

        string memory root = "root";
        vm.serializeString(
            root,
            "about",
            "EIP-712 vectors for NectarVaultBase (evm/src). Generated by evm/test/Vectors.t.sol; integers are decimal strings, bytes are 0x hex. Signer is a throwaway forge test scalar, not a real key."
        );
        vm.serializeString(root, "domain", _domainJson(84532));
        vm.serializeString(
            root,
            "settleType",
            "Settle(uint64 positionId,uint64 quoteId,uint256 repayE6,uint256 seizeRaw,address recipient,uint64 nonce,uint64 expires,uint8 kind)"
        );
        vm.serializeBytes32(root, "settleTypeHash", vault.SETTLE_TYPEHASH());
        vm.serializeString(
            root, "releaseType", "Release(uint64 positionId,address recipient,uint64 nonce,uint64 expires)"
        );
        vm.serializeBytes32(root, "releaseTypeHash", vault.RELEASE_TYPEHASH());
        vm.serializeAddress(root, "signer", authority);

        // same field values as the Solana preimage vectors (solana/.../preimage.rs tests), Base-typed
        string memory settles = "settles";
        vm.serializeString(
            settles,
            "preliq_pos7",
            _settleJson("s1", _settle(7, 9058, recipient, 1, 1_762_819_200, 1), 1_250_000_000, 12)
        );
        string memory settlesJson = vm.serializeString(
            settles,
            "self_pos0_max",
            _settleJson("s2", _settle(0, 57_544_379, recipient, 0, type(uint64).max, 2), 10_000_000_000, 0)
        );
        vm.serializeString(root, "settle", settlesJson);

        string memory rels = "releases";
        vm.serializeString(rels, "pos7", _releaseJson("r1", _release(7, recipient, 9, 1_762_819_200)));
        string memory relsJson = vm.serializeString(
            rels, "pos42_nonce_max", _releaseJson("r2", _release(42, alice, type(uint64).max, 1_700_003_600))
        );
        vm.serializeString(root, "release", relsJson);

        // negative: the same Settle built for Base mainnet (8453) must give a different digest
        NectarVaultBase.Settle memory n = _settle(7, 9058, recipient, 1, 1_762_819_200, 1);
        n.repayE6 = 1_250_000_000;
        string memory neg = "negative";
        vm.serializeString(neg, "domainChain8453", _domainJson(8453));
        string memory negJson = vm.serializeBytes32(
            neg, "settlePreliqPos7DigestChain8453", _digest(_domain(8453, VECTOR_VAULT), _settleStruct(n))
        );
        string memory out = vm.serializeString(root, "negative", negJson);

        vm.writeJson(out, PATH);

        // the file round-trips and agrees with the deployed contract
        string memory back = vm.readFile(PATH);
        assertEq(vm.parseJsonBytes32(back, ".domain.separator"), vault.domainSeparator());
        assertEq(vm.parseJsonBytes32(back, ".settle.preliq_pos7.digest"), vault.hashSettle(n));
        assertTrue(
            vm.parseJsonBytes32(back, ".negative.settlePreliqPos7DigestChain8453")
                != vm.parseJsonBytes32(back, ".settle.preliq_pos7.digest")
        );
    }

    // ------------------------------------------------------------ helpers

    function _domainJson(uint256 chainId) internal returns (string memory) {
        string memory k = string.concat("domain", vm.toString(chainId));
        vm.serializeString(k, "name", "NectarVault");
        vm.serializeString(k, "version", "1");
        vm.serializeString(k, "chainId", vm.toString(chainId));
        vm.serializeAddress(k, "verifyingContract", VECTOR_VAULT);
        vm.serializeBytes32(k, "typeHash", vault.DOMAIN_TYPEHASH());
        vm.serializeBytes32(k, "nameHash", vault.NAME_HASH());
        vm.serializeBytes32(k, "versionHash", vault.VERSION_HASH());
        return vm.serializeBytes32(k, "separator", _domain(chainId, VECTOR_VAULT));
    }

    function _settleJson(string memory k, NectarVaultBase.Settle memory m, uint256 repayE6, uint64 quoteId)
        internal
        returns (string memory)
    {
        m.repayE6 = repayE6;
        m.quoteId = quoteId;
        bytes memory enc = abi.encode(
            vault.SETTLE_TYPEHASH(),
            m.positionId,
            m.quoteId,
            m.repayE6,
            m.seizeRaw,
            m.recipient,
            m.nonce,
            m.expires,
            m.kind
        );
        bytes32 structHash = keccak256(enc);
        assertEq(structHash, _settleStruct(m));
        bytes32 digest = vault.hashSettle(m);
        assertEq(digest, _digest(_domain(84532, VECTOR_VAULT), structHash));

        vm.serializeString(k, "positionId", vm.toString(m.positionId));
        vm.serializeString(k, "quoteId", vm.toString(m.quoteId));
        vm.serializeString(k, "repayE6", vm.toString(m.repayE6));
        vm.serializeString(k, "seizeRaw", vm.toString(m.seizeRaw));
        vm.serializeAddress(k, "recipient", m.recipient);
        vm.serializeString(k, "nonce", vm.toString(m.nonce));
        vm.serializeString(k, "expires", vm.toString(m.expires));
        vm.serializeString(k, "kind", vm.toString(m.kind));
        vm.serializeBytes(k, "encodeData", enc);
        vm.serializeBytes32(k, "structHash", structHash);
        return _sigJson(k, digest);
    }

    function _releaseJson(string memory k, NectarVaultBase.Release memory m) internal returns (string memory) {
        bytes memory enc = abi.encode(vault.RELEASE_TYPEHASH(), m.positionId, m.recipient, m.nonce, m.expires);
        bytes32 structHash = keccak256(enc);
        assertEq(structHash, _releaseStruct(m));
        bytes32 digest = vault.hashRelease(m);
        assertEq(digest, _digest(_domain(84532, VECTOR_VAULT), structHash));

        vm.serializeString(k, "positionId", vm.toString(m.positionId));
        vm.serializeAddress(k, "recipient", m.recipient);
        vm.serializeString(k, "nonce", vm.toString(m.nonce));
        vm.serializeString(k, "expires", vm.toString(m.expires));
        vm.serializeBytes(k, "encodeData", enc);
        vm.serializeBytes32(k, "structHash", structHash);
        return _sigJson(k, digest);
    }

    /// @dev Adds digest, r/s/v, and the same signature in MPC response shape (F-332):
    ///      big_r.affine_point = (0x02 | y-parity) ‖ r, s.scalar = s, recovery_id = v - 27.
    function _sigJson(string memory k, bytes32 digest) internal returns (string memory) {
        (uint8 v, bytes32 r, bytes32 s) = vm.sign(AUTH_PK, digest);
        assertEq(ecrecover(digest, v, r, s), authority);
        vm.serializeBytes32(k, "digest", digest);
        vm.serializeBytes32(k, "r", r);
        vm.serializeBytes32(k, "s", s);
        vm.serializeString(k, "v", vm.toString(v));
        vm.serializeBytes(k, "signature65", abi.encodePacked(r, s, v));
        vm.serializeBytes(k, "mpcAffinePoint", abi.encodePacked(bytes1(v == 28 ? 0x03 : 0x02), r));
        return vm.serializeString(k, "mpcRecoveryId", vm.toString(v - 27));
    }
}
